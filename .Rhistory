install.packages("cluster")
install.packages("e1071")
library(cluster)
library(e1071)
set.seed(123)
x1 <- matrix(rnorm(40, mean = 2), ncol = 2)
x2 <- matrix(rnorm(40, mean = 3), ncol = 2)
x3 <- matrix(rnorm(40, mean = 4), ncol = 2)
x <- rbind(x1, x2, x3)
true_labels <- factor(rep(1:3, each = 20))
plot(x, col = true_labels, pch = 19, main = "Preklapanje oblaka")
d <- dist(x)
hc <- hclust(d, method = "complete")
clusters_hc <- cutree(hc, k = 3)
plot(x, col = clusters_hc, pch = 19, main = "Hijerarhijsko klasterovanje")
fuzzy_res <- cmeans(x, centers = 3, m = 2)
colors_rgb <- rgb(
fuzzy_res$membership[,1],  # R - klaster 1
fuzzy_res$membership[,2],  # G - klaster 2
fuzzy_res$membership[,3]   # B - klaster 3
)
plot(x, col = colors_rgb, pch = 19, main = "Fuzzy klasterovanje")
